# Copy to .env on the VM and fill in your real values:  cp .env.example .env && nano .env
# (.env is git-ignored — never commit real secrets.)

# ---- Public HTTPS domain for the API (free DuckDNS subdomain) ----
# Create it at https://www.duckdns.org and point it at THIS VM's public IP.
# Example: lorrykanakku.duckdns.org
DOMAIN=your-subdomain.duckdns.org

# ---- App ----
ENV=production
# Your Vercel site (the API also auto-allows any *.vercel.app origin):
CORS_ORIGINS=https://truck-app-self.vercel.app

# ---- Database: the SAME TiDB connection you already use on Render ----
# Copy the DATABASE_URL value straight from your Render service's env vars.
DATABASE_URL=mysql://USER:PASSWORD@gateway01.<region>.prod.aws.tidbcloud.com:4000/fleet
DB_SSL=true

# ---- JWT: reuse the SAME secret you set on Render (so existing logins keep working) ----
# Or generate a new one: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=paste-the-same-secret-you-used-on-render

# ---- Gmail SMTP (works here — Oracle leaves port 587 open) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=truckapp02@gmail.com
SMTP_PASSWORD=your-16-char-gmail-app-password
EMAIL_FROM=truckapp02@gmail.com
EMAIL_FROM_NAME=Fleet Owner
