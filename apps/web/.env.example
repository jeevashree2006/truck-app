# --- Demo vs real backend ---
# "true" serves a rich in-memory demo dataset (no backend, code 123456). "false" uses
# the real FastAPI backend with real server-generated OTPs.
VITE_USE_MOCKS=true

# Base URL of the FastAPI backend. Two dev options:
#  (a) Set to the backend URL (CORS is configured for http://localhost:3000):
#        VITE_API_URL=http://localhost:8000
#  (b) Leave EMPTY to route /api/* through the Vite proxy (no CORS preflight) —
#        configure the target via VITE_PROXY_TARGET in vite.config.ts.
# PRODUCTION (Vercel/Netlify): set this to the deployed backend URL.
VITE_API_URL=http://localhost:8000
