# Base URL of the FastAPI backend. All endpoints live under /api/v1.
# For Android emulator use http://10.0.2.2:8000, for a real device use your LAN IP.
EXPO_PUBLIC_API_URL=http://localhost:8000

# "true" (default) bypasses the network and renders from the rich in-memory mock
# dataset — so `npx expo start` is instantly demoable. Set to "false" to use the
# real backend at EXPO_PUBLIC_API_URL above.
EXPO_PUBLIC_USE_MOCKS=true
