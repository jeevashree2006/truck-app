# ---- App ----
APP_NAME="Fleet Owner API"
ENV=development
# Comma-separated list of allowed CORS origins (web + expo dev)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006

# ---- MongoDB Atlas (M0 free tier) ----
# mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=fleet

# ---- JWT ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- OTP ----
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ---- Document status thresholds (days) ----
DOC_EXPIRING_SOON_DAYS=30

# ---- Email OTP delivery ----
# EASIEST & FREE: send via Gmail SMTP using Python's stdlib (no SendGrid needed).
#   1) Google account -> Security -> turn on 2-Step Verification
#   2) https://myaccount.google.com/apppasswords -> create an App Password (16 chars)
#   3) Fill SMTP_USER (your Gmail) + SMTP_PASSWORD (the App Password, spaces removed)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME="Fleet Owner"
# Alternative provider (optional): SendGrid API key. If unset and no SMTP, OTP is
# logged to the console (dev mode).
SENDGRID_API_KEY=
EMAIL_FROM=no-reply@fleetowner.app

# ---- SMS: configure ONE provider for real delivery. If none set, the OTP is logged
#      to the console and returned by the API as dev_code (still real & server-verified).
# Fast2SMS (India — EASIEST: get a key at fast2sms.com, OTP route needs no DLT template):
FAST2SMS_API_KEY=
# Twilio (international):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# MSG91 (India — needs a DLT-approved flow with an `OTP` variable):
MSG91_AUTH_KEY=
MSG91_FLOW_ID=
MSG91_SENDER=FLEET
# Generic fallback provider:
SMS_API_KEY=
SMS_API_URL=
SMS_SENDER=FLEET

# ---- Push (Expo). Optional, used by Phase 3 reminders ----
EXPO_ACCESS_TOKEN=
